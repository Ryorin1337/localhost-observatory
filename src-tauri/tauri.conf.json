{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Localhost Observatory",
  "version": "0.1.0",
  "identifier": "dev.observatory.localhost",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Localhost Observatory",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0b101d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "本机网络活动监控：连接、进程树、协议识别和实时速率",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
